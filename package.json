{
  "name": "owner-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/supabase-db-check.mjs",
    "db:check:shared": "node scripts/supabase-db-check.mjs",
    "db:shared:branch:check": "node scripts/supabase-shared-schema-branch-check.mjs",
    "db:push:dev": "node scripts/supabase-db-push-dev.mjs",
    "db:push:shared": "node scripts/supabase-db-push-dev.mjs",
    "db:sync:from-shared": "node scripts/supabase-db-sync-from-shared.mjs",
    "seed:dev-users": "node --env-file=.env.local scripts/seed-dev-users.mjs --yes",
    "db:push": "node --env-file=.env.local scripts/supabase-db-push-dev.mjs",
    "db:push-and-seed": "pnpm db:push && pnpm seed:dev-users"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
